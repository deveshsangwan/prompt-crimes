{
  "name": "prompt-crimes",
  "version": "0.1.0",
  "description": "Generate a funny local Prompt Crimes report from AI chat histories",
  "type": "module",
  "bin": {
    "prompt-crimes": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "keywords": [
    "cli",
    "ai",
    "codex",
    "claude",
    "cursor",
    "prompt-engineering",
    "roast",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/deveshsangwan/prompt-crimes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deveshsangwan/prompt-crimes.git"
  },
  "bugs": {
    "url": "https://github.com/deveshsangwan/prompt-crimes/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.6.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
